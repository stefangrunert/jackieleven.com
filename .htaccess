# jackieleven — lokale Hommage-Seite

Options -Indexes
DirectoryIndex index.php

# --- Arbeitsmaterial ist nicht Teil der Website ---------------------------
# research/      Levens eigene Texte (Urheberrecht) + Rechercheakten
# autobiografie/ die Pastiche — darf nirgends als sein Wort erscheinen
# werkzeug/      Messwerkzeuge
# .dev/          Werkstattbericht
RedirectMatch 404 ^/(research|autobiografie|werkzeug|\.dev)(/|$)

<FilesMatch "\.(md|py|json)$">
  Require all denied
</FilesMatch>

# --- Front Controller ----------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
