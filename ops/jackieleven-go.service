[Unit]
Description=Jackie Leven Go website
After=network.target

[Service]
Type=simple
User=jackieleven
Group=jackieleven
WorkingDirectory=/var/www/jackieleven
EnvironmentFile=/etc/jackieleven/go.env
Environment=JACKIE_CONTACT_STATE_DIR=/var/lib/jackieleven-go/contact
StateDirectory=jackieleven-go
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/libexec/jackieleven-go-start
Restart=on-failure
RestartSec=3
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/jackieleven-go

[Install]
WantedBy=multi-user.target
