[Unit]
Description=Jackie Leven semantic search production
After=network-online.target jackieleven-search-db-preview.service
Wants=network-online.target
Requires=jackieleven-search-db-preview.service
[Service]
Type=simple
User=jackieleven-search
Group=jackieleven-search
EnvironmentFile=/etc/jackieleven-search/production.env
ExecStart=@RELEASE_ROOT@/bin/jackieleven-search -listen 127.0.0.1:18768 -manifest @MANIFEST@
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
MemoryMax=256M
CPUQuota=100%
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
[Install]
WantedBy=multi-user.target
