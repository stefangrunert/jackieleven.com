{{$auszug := get . "auszug"}}{{$q := get . "q"}}
{{if (truth (get $q "auszuege"))}}
  <div class="quellen-auszuege">
    {{range $pair1 := pairs (get $q "auszuege")}}{{$auszug = $pair1.Value}}
      <figure>
        <a href="{{(asset (get $auszug "image"))}}" target="_blank" rel="noopener noreferrer" title="{{(t "stimmen.auszug_gross")}}">
          <img src="{{(asset (get $auszug "image"))}}" width="{{(num (get $auszug "width"))}}" height="{{(num (get $auszug "height"))}}" loading="lazy" decoding="async" alt="{{(get (get $auszug "caption") (sprache))}}">
        </a>
        <figcaption>
          {{(get (get $auszug "caption") (sprache))}}
          <a href="{{(get $auszug "url")}}" target="_blank" rel="noopener noreferrer">{{(get (get $auszug "source") (sprache))}}</a>
        </figcaption>
      </figure>
    {{end}}
  </div>
  <p class="quellen-scan-credit">{{(t "stimmen.auszug_hinweis")}}</p>
{{end}}
