{{define "search-head"}}<!doctype html>
<html lang="{{.Lang}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer"><title>{{.L.Title}} · Jackie Leven</title>
<link rel="stylesheet" href="{{.BasePath}}/assets/css/site.css">
<style>
.search-page{max-width:1040px;width:100%;margin:0 auto;padding:1.4rem clamp(1rem,4vw,3rem) 4rem}.search-top{display:flex;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--line);padding-bottom:1.2rem;font-family:var(--rough);font-size:.9rem}.search-page h1{font-size:clamp(2rem,6vw,3.4rem);font-weight:400;line-height:1.1;margin:2rem 0 1rem}.search-page h2{font-size:1.4rem;line-height:1.4;margin-bottom:.7rem}.search-page p{margin:.6rem 0 1rem}.search-intro{max-width:48rem;color:var(--ink-soft)}.search-form{border:1px solid var(--line);border-radius:6px;padding:1.2rem;margin:1.8rem 0;background:#14171b}.search-form label{display:block;font-family:var(--rough);font-size:.86rem}.search-form input,.search-form select{display:block;width:100%;font:inherit;color:var(--ink);background:var(--bg);border:1px solid #5a6069;border-radius:3px;padding:.5rem;margin:.3rem 0 .8rem;min-height:44px}.search-form input[type=checkbox]{display:inline-block;width:1.2rem;min-height:1.2rem;margin:0 .4rem 0 0;vertical-align:middle}.search-form button{font-family:var(--rough);font-size:1rem;font-weight:600;min-height:44px;background:var(--accent);color:var(--bg);border:0;border-radius:3px;padding:.6rem 1.4rem;cursor:pointer}.search-form button:hover{background:#e7ba6e}.search-page :focus-visible{outline:3px solid var(--accent);outline-offset:3px}.search-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 1rem}.search-form .search-rerank{margin:.4rem 0 1rem}.search-help,.search-meta,.search-facts{font-family:var(--rough);font-size:.8rem;color:var(--ink-soft)}.search-facts{display:flex;flex-wrap:wrap;gap:.25rem 1.5rem;margin:1rem 0}.search-facts div{min-width:0}.search-facts dt{display:inline;font-weight:600}.search-facts dd{display:inline;margin-left:.3rem}.search-facts dd:after{content:""}.search-code{overflow-wrap:anywhere;font-size:.8rem}.search-error{border-left:3px solid #e19780;padding:1rem;background:#211b1a;margin:1.5rem 0}.search-status{border:1px solid var(--line);padding:1rem;margin:1.5rem 0}.search-results{list-style:none}.search-hit{padding:1.6rem 0;border-bottom:1px solid var(--line)}.search-text{white-space:pre-wrap;overflow-wrap:anywhere}.search-hit .search-text{color:var(--ink-soft)}.search-full-text{font-size:1.12rem;line-height:1.85;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:1.5rem 0;margin:1.5rem 0}.search-page details{margin:1rem 0}.search-page summary{cursor:pointer;color:var(--accent)}.search-page pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.8rem;line-height:1.6;padding:1rem;background:#14171b}.search-foot{margin-top:2rem;padding-top:1rem;border-top:1px solid var(--line)}@media(max-width:600px){.search-grid{grid-template-columns:1fr 1fr}.search-form{padding:1rem}.search-page{font-size:17px}}@media(max-width:380px){.search-grid{grid-template-columns:1fr}}
</style></head><body><main class="search-page"><nav class="search-top" aria-label="Navigation"><a href="{{.BasePath}}/{{.Lang}}/">Jackie Leven · {{.L.Home}}</a><a href="{{.OtherURL}}" lang="{{if eq .Lang "de"}}en{{else}}de{{end}}">{{if eq .Lang "de"}}English{{else}}Deutsch{{end}}</a></nav>{{end}}
{{define "search-foot"}}<div class="search-foot search-help">{{.L.Privacy}}</div></main></body></html>{{end}}
