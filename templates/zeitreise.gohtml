{{$aktiv := get . "aktiv"}}{{$alle := get . "alle"}}{{$i := get . "i"}}{{$n := get . "n"}}{{$nach := get . "nach"}}{{$s := get . "s"}}{{$vor := get . "vor"}}

<div class="stage-wrap">

  <nav class="graph" aria-label="{{(t "graph.label")}}">
    <div class="graph-viewport" id="g-viewport">
      <div class="graph-track" id="g-track" data-seo="{{(seoAttribut "zeitreise" (list) (t "titel.zeitreise"))}}" data-alternativen="{{(alternativen)}}"{{if base_path}} data-canonical-alternativen="{{(canonical_alternativen)}}"{{end}} data-titel="{{(t "titel.zeitreise")}}">
        {{range $pair1 := pairs $alle}}{{$i = $pair1.Key}}{{$s = $pair1.Value}}
          <a class="g-marker{{(choose (equal $i $aktiv) " active" "")}}"
             href="{{(url "station" (dict "slug" (get $s "slug")))}}"
             data-i="{{$i}}"
             data-seo="{{(seoAttribut "station" (dict "slug" (get $s "slug")) (t "titel.station" (dict "jahr" (get $s "jahr") "titel" (get (sfeld $s "titel") 0))))}}"
             data-art="{{(get $s "art")}}"
             data-jahr="{{(get $s "jahr")}}"
             data-alternativen="{{(alternativen (get $s "slug"))}}"{{if base_path}} data-canonical-alternativen="{{(canonical_alternativen (get $s "slug"))}}"{{end}}
             {{(attrs (choose (equal $i $aktiv) "aria-current=\"true\"" ""))}}>
            <span class="dot"></span>
            <span class="g-label">
              <span class="g-year">{{(get $s "jahr")}}</span>
              <span class="g-era">{{(sfeld_html $s "titel")}}</span>
            </span>
          </a>
        {{end}}
      </div>
    </div>
  </nav>

  <main class="stage" id="stage">{{(render "buehne" (dict "st" (get $alle $aktiv)))}}</main>

</div>

<nav class="pager" aria-label="{{(t "pager.label")}}">
  <a class="knopf" href="{{(url "station" (dict "slug" (get $vor "slug")))}}" rel="prev">&larr; {{(get $vor "jahr")}}</a>
  <span class="count" id="count">{{(sprintf "%02d / %02d" (add $aktiv 1) $n)}}</span>
  <a class="knopf" href="{{(url "station" (dict "slug" (get $nach "slug")))}}" rel="next">{{(get $nach "jahr")}} &rarr;</a>
</nav>
